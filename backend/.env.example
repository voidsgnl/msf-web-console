# msfrpcd connection settings
# Start msfrpcd first, e.g.:
#   msfrpcd -U msf -P changeme -a 127.0.0.1 -p 55553 -S
# (-S disables SSL for local testing; omit it to keep SSL on, recommended)

MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_USER=msf
MSF_RPC_PASS=changeme
MSF_RPC_SSL=true

# Set to false only if you started msfrpcd with -S (no SSL) for local dev
MSF_RPC_VERIFY_CERT=false
