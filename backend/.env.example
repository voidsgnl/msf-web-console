# msfrpcd connection settings
# Start msfrpcd first, e.g.:
#   msfrpcd -U msf -P changeme -a 127.0.0.1 -p 55553 -S
# (-S disables SSL in this Metasploit build - confirmed empirically via curl.
#  If your build's -S instead ENABLES SSL, set MSF_RPC_SSL=true below and
#  drop -S from the start command, or vice versa. Quick way to check: run
#  `curl -vk https://127.0.0.1:55553/api/1.0` - if it hangs on the TLS
#  handshake, your server is plain HTTP; use MSF_RPC_SSL=false.)

MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_USER=msf
MSF_RPC_PASS=changeme
MSF_RPC_SSL=false

# Set to true only if msfrpcd is actually serving HTTPS (see note above)
MSF_RPC_VERIFY_CERT=false

# Optional file-backed loot downloads. Only paths listed here are eligible
# when a db.loots response contains a path but no inline data bytes.
# Prefer exact files to granting access to a broad directory.
# MSF_LOOT_ALLOWED_FILES=/tmp/msf-web-console-loot-test.txt
# MSF_LOOT_ALLOWED_DIRS=/home/you/.msf4/loot

# Web console access boundary. These settings restrict origins/hosts; they do not enable authentication.
# Keep the application local-only. Do not expose it through a LAN address or reverse proxy.
MSF_WEB_ALLOWED_HOSTS=localhost,127.0.0.1,::1
MSF_WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
